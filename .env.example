# ---- Solana ----
# Dedicated RPC (Helius / Triton). The public endpoint works for paper mode only.
TENFOLD_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Jupiter Swap API key (free at portal.jup.ag). api.jup.ag throttles keyless calls to ~0.5 req/s; lite-api is deprecated.
TENFOLD_JUPITER_API_KEY=
# Override the Jupiter host (self-hosted router); leave empty for https://api.jup.ag
TENFOLD_JUPITER_BASE_URL=
# Optional Jito block engine for bundle submission (leave empty to send through the RPC)
TENFOLD_JITO_URL=
TENFOLD_JITO_TIP_LAMPORTS=100000
TENFOLD_PRIORITY_FEE_MICROLAMPORTS=50000

# ---- Storage ----
TENFOLD_DB_PATH=./data/tenfold.sqlite
TENFOLD_PROJECTS_DIR=./projects
TENFOLD_KEYSTORE_DIR=./data/keys
# Password that encrypts the project wallets on disk. Long and random. Never commit it.
TENFOLD_KEYSTORE_PASSWORD=

# ---- Fees ----
# Wallet that receives Tenfold's accrued fees on a sweep (sweeps stay operator-initiated in the beta). Empty = no sweep.
TENFOLD_FEE_WALLET=
# Fee schedule in basis points (defaults: 0.5% of vault volume, 2% at cashout, referral 10% of fees, referred founders 10% off)
TENFOLD_FEE_VOLUME_BPS=50
TENFOLD_FEE_CASHOUT_BPS=200
TENFOLD_REFERRAL_BPS=1000
TENFOLD_REFERRED_DISCOUNT_BPS=1000

# ---- Agent ----
TENFOLD_TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
TENFOLD_ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Proof page ----
TENFOLD_PROOF_PORT=8787
TENFOLD_PROOF_BASE_URL=http://localhost:8787
# Secret used to sign /verify responses until the on-chain vault signs them
TENFOLD_PROOF_SIGNING_SECRET=

# ---- Web onboarding (founder signs in with his wallet, Tenfold creates the project wallet) ----
# Needs TENFOLD_KEYSTORE_PASSWORD to encrypt new wallets; it never decrypts one.
TENFOLD_ONBOARD_PORT=8788
TENFOLD_ONBOARD_BASE_URL=http://localhost:8788

# ---- Public trader bot (separate token from the founder agent bot) ----
TENFOLD_TRADER_BOT_TOKEN=

# ---- Marketing module (npm run marketing) ----
# X API v2, OAuth 1.0a user context of the Tenfold account that posts (the project is @-mentioned). All four or none.
TENFOLD_X_API_KEY=
TENFOLD_X_API_SECRET=
TENFOLD_X_ACCESS_TOKEN=
TENFOLD_X_ACCESS_SECRET=
# Handle of that account, for the links sent back to the founder (without @)
TENFOLD_X_ACCOUNT_HANDLE=
# Bot that posts to the projects' public Telegram channels (must be an admin there); defaults to TENFOLD_TELEGRAM_BOT_TOKEN
TENFOLD_MARKETING_BOT_TOKEN=
# Max posts per project per channel per rolling 24h (default 4; badge downgrades always go out)
TENFOLD_MARKETING_MAX_POSTS_PER_DAY=4
# 1 = log posts instead of publishing (also lets paper projects through); never set in production
TENFOLD_MARKETING_DRY_RUN=0
# 1 = post for paper projects too (simulated numbers; dry runs only)
TENFOLD_MARKETING_ALLOW_PAPER=0

# ---- Misc ----
TENFOLD_LOG_LEVEL=info
# Set to 1 to run paper projects against a simulated feed (no network at all)
TENFOLD_SIM=0
