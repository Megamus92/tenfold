{
  "name": "tenfold-vault-program",
  "version": "0.1.0",
  "private": true,
  "description": "Anchor workspace for the Tenfold vault program (standalone, not part of the npm workspaces at the repo root)",
  "scripts": {
    "build": "anchor build",
    "build:test": "anchor build -- --features testing",
    "test": "anchor test",
    "test:full": "TENFOLD_TEST_CLOCK=1 anchor test -- --features testing",
    "lint": "prettier --check tests/**/*.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "chai": "^4.4.1",
    "mocha": "^10.7.0",
    "prettier": "^3.3.3",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.5.4"
  }
}
